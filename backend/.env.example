# ============================================================================
# HarnessPRD Backend 环境变量模板
# ----------------------------------------------------------------------------
# 使用方式：
#   cp .env.example .env      （Windows: copy .env.example .env）
# 然后填入你自己的密钥。.env 已在 .gitignore 中忽略，切勿提交真实密钥。
# ============================================================================

# ---------------------------------------------------------------------------
# LLM Provider 凭据
# 留空即可启动服务，只有在真正调用模型时才需要填入。
# 按供应商分组：Anthropic / OpenAI（兼容）/ 火山方舟。
# ---------------------------------------------------------------------------

# -------------------- Anthropic（Claude） --------------------
# API Key（https://console.anthropic.com/）
ANTHROPIC_API_KEY=

# 自定义 API 地址（可选）：自建网关 / 中转 / 兼容服务，留空用官方默认
ANTHROPIC_API_URL=

# 单次回复的最大 token 数；Anthropic 超限时 stop_reason=max_tokens
ANTHROPIC_MAX_TOKENS=4096

# -------------------- OpenAI（通用兼容协议） --------------------
# API Key（https://platform.openai.com/api-keys）
OPENAI_API_KEY=

# 自定义 API 地址（可选）：兼容 OpenAI 协议的服务（vLLM / One API / 中转）
OPENAI_API_URL=

# 单次回复的最大 token 数
OPENAI_MAX_TOKENS=4096

# -------------------- 火山方舟（Volcano Ark，调用豆包系列） --------------------
# API Key —— 调用豆包请用这里的 ARK_* 配置，不要复用 OPENAI_API_KEY
# 申请：https://console.volcengine.com/ark
ARK_API_KEY=

# API 地址（一般无需修改）
ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 是否开启方舟混合思考模型的深度思考（reasoning）。
# 默认关闭（false）：模型直接回答，避免「首字极慢 + 正文爆发」观感。
# 如需查看模型自带的思考过程，可改为 true。
ARK_THINKING_ENABLED=false

# 单次回复的最大 token 数。默认 4096；生成 PRD 等长文档时可能被截断
# （finish_reason=length），建议调大到模型支持的上限，如 131072（128k）。
ARK_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# 默认模型配置
# ---------------------------------------------------------------------------

# 默认使用的 LLM 供应商：anthropic | openai | ark
DEFAULT_LLM_PROVIDER=ark

# 默认模型名称（方舟豆包模型）
DEFAULT_LLM_MODEL=doubao-seed-2-1-turbo-260628

# ---------------------------------------------------------------------------
# 服务配置
# ---------------------------------------------------------------------------

# 允许跨域访问的来源，多个用英文逗号分隔，例如：
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173

# 监听地址（0.0.0.0 表示允许外部访问；仅本机请用 127.0.0.1）
HOST=0.0.0.0

# 监听端口
PORT=8000
