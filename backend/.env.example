# ============================================================================
# PRDwright Backend 环境变量
# ----------------------------------------------------------------------------
# 使用方式：
#   cp .env.example .env      （Windows: copy .env.example .env）
# 然后填入你自己的密钥。.env 已在 .gitignore 中忽略，切勿提交真实密钥。
# ============================================================================

# ---------------------------------------------------------------------------
# LLM Provider 凭据
# 留空即可启动服务，只有在真正调用模型时才需要填入。
# ---------------------------------------------------------------------------

# -------------------- Anthropic（Claude） --------------------
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=
ANTHROPIC_MAX_TOKENS=4096

# -------------------- OpenAI（通用兼容协议） --------------------
OPENAI_API_KEY=
OPENAI_API_URL=
OPENAI_MAX_TOKENS=4096

# -------------------- 火山方舟（Volcano Ark，调用豆包系列） --------------------
ARK_API_KEY=
# ⚠️ 键名是 ARK_BASE_URL，不是 ARK_API_BASE_URL。
# 字段名是 `ark_base_url`，pydantic-settings 按「字段名大写」匹配环境变量；
# 写成 ARK_API_BASE_URL 会被静默忽略（`extra="ignore"`），于是你改的自定义地址
# 从来没生效过，而服务一切正常、只是连的官方默认地址。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_THINKING_ENABLED=false
ARK_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# 默认模型配置
# ---------------------------------------------------------------------------
#
# ⚠️ v16 起，**供应商以数据库为准**，这两项只负责「首次播种」与「兜底」：
#   - 迁移 v16 会把当前这一对值播进 `model_providers` 的内置行（只插不覆盖）；
#   - 之后在后台「配置」页切换供应商、改模型，不再需要动这个文件、也不用重启；
#   - 表不可用（降级）时仍按这里回退，所以保留它们是有意义的。
#
# 密钥始终留在本文件（或进程环境）里：数据库只存**变量名**，不存密钥值（ADR-042）。
#
# 默认使用的 LLM 供应商：anthropic | openai | ark
DEFAULT_LLM_PROVIDER=ark
DEFAULT_LLM_MODEL=doubao-seed-2-1-turbo-260628

# ---------------------------------------------------------------------------
# Token 预算（事前）
# ---------------------------------------------------------------------------
# 事后计量只能告诉你「刚才花了多少」，钱已经付了；下面这几个开关负责在调用
# **发出之前**拦住明显失控的请求（例如章节上下文滚雪球、误把整篇 PRD 当需求再生成一遍）。
# 超顶时这次调用根本不会发出，前端收到的是 INVALID_REQUEST（重试也没用，需要精简输入）。

# 是否在调用模型前做预算检查。关闭后只做事后计量、不做任何拦截。
# 仅在排查「是不是误拦了正常请求」时临时关闭。
LLM_BUDGET_ENABLED=true

# 业务顶的默认值（token）。有效预算 = min(物理顶, 业务顶)：
# 物理顶来自模型注册表（上下文窗口 − 预留输出），业务顶来自这里。
# 故意把业务顶设得比物理顶小——让输入在逼近模型极限之前就先收束，
# 而不是等上游返回一句厂商自己的报错（那时钱已经花了、文案也不可控）。
LLM_BUDGET_DEFAULT_CAP=120000

# 按 step 覆盖业务顶。step 是「任务类型:阶段」，如 prd:writing / prd:reviewing；
# 只写任务类型（如 prd=90000）则对该类型下的所有阶段生效。
# 未列出的 step 用 LLM_BUDGET_DEFAULT_CAP；格式写错的项会被忽略，不会让服务起不来。
# 例：给审核一步单独收紧（审核输入通常比撰写短）
# LLM_BUDGET_CAPS=prd:reviewing=60000,api_docs=60000
LLM_BUDGET_CAPS=

# 估算值达到有效预算的这个比例时记一条告警（随 run_summary 回传）。只提示、不拦截。
LLM_BUDGET_WARN_RATIO=0.8

# 覆盖模型注册表里的上下文窗口（token）。0 表示用注册表的值。
# 换了表里没有的型号、或厂商调整了窗口时改这一个变量即可，不必改代码。
LLM_CONTEXT_WINDOW=0

# ---------------------------------------------------------------------------
# 超时与重试（单次调用自愈）
# ---------------------------------------------------------------------------
# 背景：三家 SDK 各自带着「默认重试 2 次 + 默认超时 600 秒」在跑，而这份配置从未显式管过它们
# ——不知道重试在发生，比没有重试更糟。下面四个开关把这件事摆到明面上，并把重试收归
# 后端自己管，好让失败的那次尝试也能被计量（见回执里的「失败调用」）。

# 帧间隔超时（秒）：相邻两次数据之间最多等多久。
# ⚠️ 它不是总时长！底层 httpx 的 read timeout 是 inter-byte 语义，约束的是「两次数据之间」，
#    所以一个每 59 秒才吐一个字的模型，能把这次调用无限拖下去而永不超时。
#    要约束总时长请用下面的 LLM_TOTAL_TIMEOUT。
# 0 = 沿用各家 SDK 自己的默认值（实测 ark / openai / anthropic 均为 600 秒）。
LLM_TIMEOUT=60

# 单次调用的墙钟硬顶（秒），超过就取消这次调用。
# 范围是按「章节」计的（一次章节生成 ≈ 数万 token 输出），不是整份 PRD，所以 30 分钟足够宽松。
# 0 = 不设硬顶。
LLM_TOTAL_TIMEOUT=1800

# 失败后最多额外重试几次。只在**还没产出任何内容之前**失败才重试——
# 一旦已经向前端交付过增量就不再重试（那些字符撤不回来，重来会出现重复内容）。
# 这也是它几乎不花钱的原因：此时通常还没产生输出 token。
# 各供应商 SDK 自身的重试会被显式关掉（设为 0），避免两层重试叠加成 2×N 次。
LLM_MAX_RETRIES=1

# 两次尝试之间的等待秒数（固定退避）。次数只有一次，用不上指数退避，
# 留一点间隔是为了避开上游刚抖动完的那几个瞬间。
LLM_RETRY_DELAY=1.5

# ---------------------------------------------------------------------------
# PRD 生成（分章节：逐章撰写 → 章节审核 → 必要时改写）
# ---------------------------------------------------------------------------

# 是否启用章节审核。审核会为每一章多发一次模型调用，因此它同时是「耗时 / 成本」的
# 总开关：实测一整篇 PRD 的耗时大约是「仅撰写」的两倍以上。关掉后只写不审。
PRD_SECTION_REVIEW_ENABLED=true

# 单个章节最多改写几轮（0 表示只审不改）。达到上限就保留当前版本，
# 避免审核与改写互相拉扯导致无限循环。
PRD_SECTION_MAX_REWRITES=1

# 章节流水线的并发度。1 = 串行（每章都能带上已定稿的前序章节）；
# 3 = 生成 / 审核 / 改写三车道并行（后章基于前章草稿，跨章一致性由最终审核结论兜底）。
# 并发越高越容易撞单供应商限流——项目不做自动切换供应商（ADR-016）。
PRD_PIPELINE_CONCURRENCY=3

# 单章在某一阶段失败后的最多重试次数（总尝试 = 1 + 该值）。
# 只重试该阶段本身；与 LLM_MAX_RETRIES（单次调用重试）是两层，实际调用次数是两者之积。
# 撰写用尽 → 写占位；审核用尽 → 保留正文；改写用尽 → 保留改写前版本。
PRD_SECTION_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# 文档审核（整篇 / 分章节共用）
# ---------------------------------------------------------------------------

# 审核这次调用的 max_tokens。审核只是「判定 + 批注」，输出量远小于正文；
# 给个小上限既省时间也省 token。被截断时按「审核失败 → 通过」处理（审核是锦上添花，
# 不能因为它把已经生成好的正文拖垮）。
# ⚠️ 它靠「换一个模型实例」生效：方舟封装只读实例上的 max_tokens，调用参数无效。
DOC_REVIEW_MAX_TOKENS=2048

# PRD 单章节审核的 max_tokens（只审一章，比整篇更小）。
PRD_SECTION_REVIEW_MAX_TOKENS=1024

# 触发改写的最低严重度，两条链路共用。
#   high（默认）：只有「编造」「覆盖缺失」这类真问题才自动改。
#   medium：连「空泛表述」「结构不符」也改——这两条口径几乎必然命中，
#           会让「审一次 → 改一次」变成常态，时延翻倍而收益极小。
# 注意：审核结论里的 issues 不受影响，medium 照样报给用户，只是不自动改。
REVIEW_REWRITE_MIN_SEVERITY=high

# 整篇文档改写是否走「分节改写」（只重写受影响的章节，拼回全文）。
# 关掉即退回整篇重写——分节改写出问题时的回退开关。
DOC_SECTION_REWRITE_ENABLED=true

# ---------------------------------------------------------------------------
# 认证（登录 / 注册）
# ---------------------------------------------------------------------------

# 是否启用登录鉴权。
#   true（默认，也是生产环境的唯一正确值）：除白名单接口外一律要求登录。
#       白名单只有：/ 、/health 、/api/auth/*（登录注册自身）、/api/conversation/questions。
#   false：所有接口放行，并以内置的 dev 用户身份运行，仅供本地功能调试。
#       注意这个开关是**全局**的——设为 false 时任何能访问到服务的人都能消耗你的模型额度。
AUTH_ENABLED=true

# 登录会话的有效时长（小时）。过期后需要重新登录。
AUTH_SESSION_TTL_HOURS=168

# 存放会话 token 的 Cookie 名称
AUTH_COOKIE_NAME=prdwright_session

# 会话 Cookie 是否只允许通过 HTTPS 传输。
# 本地 http:// 调试必须留 false，否则浏览器根本不会回传 Cookie，表现为「登录了但又没登录」。
# 部署到 HTTPS 环境后应改为 true。
AUTH_COOKIE_SECURE=false

# 初始邀请码。首次启动且 invite_codes 表为空时自动播种这一条（不限次数、永不过期）。
# 注册必须填写有效邀请码；需要发限量 / 限时的码，用运维脚本：
#   uv run python scripts/auth_cli.py invite WELCOME --max-uses 5 --expires 2026-12-31
INVITE_CODE=123456

# 初始管理员账号，仅在 users 表为空时自动创建，用于第一次登录。留空则不自动创建。
# 也可以在启动后用运维脚本建号：uv run python scripts/auth_cli.py user alice
INIT_ADMIN_USER=
INIT_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------

# SQLite 数据库文件路径。留空则使用后端项目根目录下的 prdwright.db。
# 该文件已在 .gitignore 中忽略，切勿提交。
DB_PATH=

# ---------------------------------------------------------------------------
# 技能包（各生成产物的提示词资产）
# ---------------------------------------------------------------------------

# skills 根目录。部署时后端与 skills/ 目录可能不在同一棵目录树里，用它显式指定；
# 留空则从后端源码位置向上逐级查找（本地开发通常不用配）。
# 该目录下每个带 skill.yaml 的子目录就是一个技能包：它自己声明服务于哪些产物
# （applies_to）与需要哪些资源（references）。**新增技能包 = 新增一个目录**，
# 服务启动时自动扫描登记，不必改代码。
PRDWRIGHT_SKILLS_DIR=

# 技能资产有问题时是否中止启动。问题包括：skill.yaml 读不动、必需资源缺失、
# 同一产物被多个技能包声明。
# false（默认）：本地调试缺 skills 也能起服务，只是相关产物的生成退回内置提示词，
#               回执上会显式标出，不会悄悄降级；是否健康可看 /health 的 skills 项。
# true：        存在问题即在启动时报错，并列出是哪个包、缺了什么——**部署环境建议设为 true**，
#               漏打包 skills/ 要在一开始就炸出来，而不是等文档风格悄悄变了才发现。
PRDWRIGHT_SKILLS_STRICT=false

# ---------------------------------------------------------------------------
# 可观测性（日志）
# ---------------------------------------------------------------------------

# 日志级别：DEBUG / INFO / WARNING / ERROR。
# 拼错的名字会退回 INFO，不让一个笔误把服务拦在启动之外。
LOG_LEVEL=INFO

# 日志格式。
# text（默认）：给人看的格式，每条都带请求号，本地排查直接粘号来搜：
#              2026-10-15T08:30:00.123Z INFO  backend.api.access [req=abc123] 请求完成 ...
# json：        一行一条 JSON，可直接喂给日志采集——**部署环境建议设为 json**。
# 两种格式带**同一组字段**（都含 request_id），所以切换不会丢信息。
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# 服务配置
# ---------------------------------------------------------------------------

# 允许跨域访问的来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 监听地址（0.0.0.0 表示允许外部访问；仅本机请用 127.0.0.1）
HOST=0.0.0.0

# 监听端口
PORT=8000
