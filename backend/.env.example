# ============================================================================
# PRDwright Backend 环境变量
# ----------------------------------------------------------------------------
# 使用方式：
#   cp .env.example .env      （Windows: copy .env.example .env）
# 然后按需取消注释、填上密钥。.env 已在 .gitignore 中忽略，切勿提交真实密钥。
#
# ⚠️ 本文件**没有任何生效配置**——一行都没有，全部以注释形式给默认值：
#   · 可调参数（模型接入 / 预算 / 超时 / 审核 / 额度 / 登录策略）→ 管理后台
#   · 启动项（端口 / 库路径 / 日志 / 鉴权总开关…）→ 见文末，按需取消注释
#   · 密钥值 → 见第一节（唯一必须由你提供的东西）
# 照原样 `cp` 过来就能起服务：不写任何一行，用的就是推荐默认值。
# ============================================================================

# ---------------------------------------------------------------------------
# 一、密钥值：**不在这里**
# ---------------------------------------------------------------------------
# 模型密钥已迁入**管理后台「模型配置」页**：录入后由服务端用主密钥加密，
# 以密文存进数据库（见 ADR-053）。本文件里**不放任何密钥**。
#
# 你只需要准备一把「主密钥」，它决定所有密文能不能解开：
#     cd backend && uv run python ../scripts/keygen/generate_keys.py
# 生成位置：backend/secrets/master.key（600 权限，已在 .gitignore）。
# 它不进数据库、不进本文件；**丢了这个文件，所有已录入的密钥都解不开**。
# 备份时请把它与数据库分开放。
#
# 本地 vLLM / Ollama 这类不要钥匙的接入点：后台建配置时把密钥填成占位值
# （如 not-needed）即可——OpenAI 兼容客户端要求 api_key 非空。

# ---------------------------------------------------------------------------
# 启动项（按需开启：去掉行首的 "# " 才生效；不写就是用后面标的默认值）
# ---------------------------------------------------------------------------
# 为什么这些不在管理后台：它们决定「进程怎么起来」，改了必须重启，
# 放进后台只会制造「显示已保存、实际没变」的错觉（ADR-041）。
# 下面列全了所有启动项——看着多，但绝大多数情况一个都不用动。
#
# 鉴权
# AUTH_ENABLED=true                  # false = 关闭鉴权、以内置 dev 用户运行（仅本地调试，危险）
# AUTH_COOKIE_NAME=prdwright_session
# INVITE_CODE=123456                 # 首次启动播种的邀请码
# INIT_ADMIN_USER=                   # 仅 users 表为空时自动建号；留空则不建
# INIT_ADMIN_PASSWORD=
#
# 存储与资源
# DB_PATH=                           # 留空 = backend/prdwright.db
# PRDWRIGHT_SKILLS_DIR=              # 留空 = 从源码位置向上查找 skills/
# PRDWRIGHT_SKILLS_STRICT=false      # 部署建议 true：漏打包技能包时启动即失败
#
# 日志
# LOG_LEVEL=INFO                     # DEBUG / INFO / WARNING / ERROR
# LOG_FORMAT=text                    # text | json（部署建议 json）
#
# 服务
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174   # 默认已含后台端口 5174
# HOST=0.0.0.0                       # 仅本机访问请改 127.0.0.1
# PORT=8000
