# ============================================================================
# HarnessPRD Backend 环境变量模板
# ----------------------------------------------------------------------------
# 使用方式：
#   cp .env.example .env      （Windows: copy .env.example .env）
# 然后填入你自己的密钥。.env 已在 .gitignore 中忽略，切勿提交真实密钥。
# ============================================================================

# ---------------------------------------------------------------------------
# LLM Provider 凭据
# 留空即可启动服务，只有在真正调用模型时才需要填入。
# ---------------------------------------------------------------------------

# Anthropic Claude API Key（https://console.anthropic.com/）
ANTHROPIC_API_KEY=

# OpenAI API Key（https://platform.openai.com/api-keys）
OPENAI_API_KEY=

# 自定义 API 地址（可选）
# 用于自建网关、中转代理或兼容 OpenAI 协议的服务（如 vLLM / One API / 各类中转）。
# 留空则使用官方默认地址。
# 例：https://your-gateway.example.com/v1
ANTHROPIC_API_URL=

OPENAI_API_URL=

# ---------------------------------------------------------------------------
# 默认模型配置
# ---------------------------------------------------------------------------

# 默认使用的 LLM 供应商：anthropic | openai
DEFAULT_LLM_PROVIDER=anthropic

# 默认模型名称（示例为 Claude Sonnet 4）
DEFAULT_LLM_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------------------------
# 服务配置
# ---------------------------------------------------------------------------

# 允许跨域访问的来源，多个用英文逗号分隔，例如：
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173

# 监听地址（0.0.0.0 表示允许外部访问；仅本机请用 127.0.0.1）
HOST=0.0.0.0

# 监听端口
PORT=8000
