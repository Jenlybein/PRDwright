# ---------------------------------------------------------------------------
# PRDwright v9 部署环境变量样例
#
# 用法：在本目录 `cp .env.example .env`（Windows: `Copy-Item .env.example .env`），
# 然后改掉标了「必须改」的几项。compose 用这份文件做变量插值，并把它经
# `env_file` 注入 api 容器。
#
# 两条书写约定：
# · 等号右侧不要写行尾注释，值里也避免出现 `#`（compose 会当成注释截掉）。
# · 被注释掉的行 = 「保持镜像里的默认值」，需要时去掉行首的 `#` 再改。
# ---------------------------------------------------------------------------

# ============================== 入口与镜像 ==================================
# 宿主机发布端口。默认 80——对外只开这一个端口；api 的 8000 从不 publish。
# 只有 80 被占用、或 CI 要避开特权端口时才改（README 的地址也要跟着换）。
PRDWRIGHT_HTTP_PORT=80

# 两个镜像的 tag，默认 local。CI 用 `git describe` 时设成对应版本，
# 让「线上跑的是哪份提交」可查。改了它之后，README 里「生成主密钥」
# 命令中的 `prdwright-api:local` 也要换成同一个 tag。
# PRDWRIGHT_IMAGE_TAG=local

# ========================= 首次启动自举（只在空库时生效）=====================
# 首个管理员账号：users 表为空时自动创建，且**直接是管理员**——否则全新部署后
# 没有任何人进得了后台，而任命管理员本身又需要管理员权限（死锁）。
# 【必须改】库一旦非空，这两项就不再起作用。
INIT_ADMIN_USER=admin
INIT_ADMIN_PASSWORD=change-me-before-first-start

# 初始邀请码：invite_codes 表为空时自动播种，注册时必须填写。
# 【必须改】留空表示不播种（那就只剩管理员能进）。
INVITE_CODE=change-me-before-first-start

# 是否开放自助注册。false 时注册接口一律拒绝，新账号只能由管理员创建；
# 已有账号的登录不受影响。
AUTH_ALLOW_REGISTER=true

# ============================== 登录与安全 ==================================
# 会话 Cookie 是否只允许通过 HTTPS 传输。
# 纯 HTTP 部署（含 http://localhost）必须是 false，否则浏览器不回传 Cookie，
# 表现是「登录接口返回 200，下一个请求又是未登录」。前置 HTTPS 反代后改 true。
AUTH_COOKIE_SECURE=false

# 登录会话有效时长（小时）。默认 7 天。
# AUTH_SESSION_TTL_HOURS=168

# ================================= 日志 =====================================
# DEBUG / INFO / WARNING / ERROR；认不出的名字退回 INFO，不会让服务起不来。
LOG_LEVEL=INFO

# text 给人看 / json 一行一条给采集。镜像默认 json，部署环境建议保持。
# LOG_FORMAT=json

# ================================= 排空 =====================================
# 收到终止信号后等待在途任务的**上限**（秒），默认 30。这是上限不是必等：
# 任务都结束了就立刻退出；到点还没跑完的被标成「已取消」并落终态。
# ⚠️ compose 的 stop_grace_period 是 45 秒，必须保持大于这个值，
#    否则进程会在写完终态之前被 SIGKILL，任务又变回 running 的尸体。
# PRDWRIGHT_DRAIN_TIMEOUT=30

# ================================= 跨域 =====================================
# 同源部署（`/`、`/admin/`、`/api/` 同一个域名）**不需要** CORS，留空即可。
# 只有把前端单独跑在别的端口（如 `npm run dev` 的 5173/5174）时才填，逗号分隔。
CORS_ORIGINS=

# ================== 路径与数据库（镜像 ENV 的默认值，仅核对用）===============
# 下面五条是镜像里已经写好的契约。容器里改它们等于绕过镜像的卷布局，
# 正常部署**不要**取消注释。写在这里是为了让你一眼看到「东西落在哪」。
# DATABASE_URL=sqlite:////var/lib/prdwright/prdwright.db
# LOG_DIR=/var/log/prdwright
# PRDWRIGHT_MASTER_KEY_PATH=/secrets/master.key
# PRDWRIGHT_SKILLS_DIR=/app/skills
# PRDWRIGHT_SKILLS_STRICT=true
